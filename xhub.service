[Unit]
Description=X-HUB v1.0.0 — X/Twitter Video Downloader PWA Backend
After=network.target

[Service]
# Adjust these paths to match your deployment directory
WorkingDirectory=/opt/xhub
ExecStart=/opt/xhub/venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8866

# 进程崩溃后自动重启
Restart=always
RestartSec=5

# 运行该服务的用户（推荐使用普通用户，比如 ubuntu 或 www-data）
User=root

# 标准输出和错误日志会进入 syslog / journalctl
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=xhub

[Install]
WantedBy=multi-user.target
