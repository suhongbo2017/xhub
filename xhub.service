[Unit]
Description=X-HUB Video Downloader PWA Backend
After=network.target

[Service]
# 请根据你在 Ubuntu 上的实际路径修改 WorkingDirectory 和 ExecStart
# 例如你把项目放在了 /opt/xhub
WorkingDirectory=/opt/xhub

# 执行启动脚本
ExecStart=/bin/bash /opt/xhub/start.sh

# 进程崩溃后自动重启
Restart=always
RestartSec=5

# 运行该服务的用户（推荐使用普通用户，比如 ubuntu 或 www-data）
User=root

# 标准输出和错误日志会进入 syslog / journalctl
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=xhub

[Install]
WantedBy=multi-user.target
