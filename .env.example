# X HUB 环境变量配置（复制为 .env 后修改）

# ── 服务配置 ──
PORT=8866                      # 容器内端口（docker-compose 映射到宿主机）
HOST=0.0.0.0                   # 监听地址

# ── yt-dlp 配置 ──
# COOKIE_FILE: cookies.txt 文件路径（容器内自动使用 /app/xcookies.txt）
# COOKIE_SRC: 可选 - 远程 Cookie URL，容器启动时自动下载
# COOKIE_URL=https://your-server.com/cookie.txt

# ── Cookie 管理 ──
# AUTO_COOKIE_FETCH: 是否自动从远程获取 Cookie
AUTO_COOKIE_FETCH=false

# ── 日志配置 ──
LOG_LEVEL=info                 # debug / info / warning / error
MAX_LOG_SIZE=10485760          # 10MB, 日志轮转大小

# ── 安全 ──
# ENABLE_AUTH: 是否启用简单密码保护 (生产环境建议开启)
ENABLE_AUTH=false
# AUTH_PASSWORD=your_secret_password_here
